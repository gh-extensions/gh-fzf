{{- $headerColor := "blue+b" -}}
{{- printf "%s  %s  %s  %s  %s  %s\n"
    (printf "%-7s" "NUMBER" | autocolor $headerColor)
    (printf "%-14s" "UPDATED" | autocolor $headerColor)
    (printf "%-60s" "TITLE" | autocolor $headerColor)
    (printf "%-20s" "AUTHOR" | autocolor $headerColor)
    (printf "%-16s" "MILESTONE" | autocolor $headerColor)
    ("LABELS" | autocolor $headerColor)
-}}

{{- range . -}}
    {{- $milestoneTitle := "" -}}
    {{- if ne .milestone nil -}}
        {{- $milestoneTitle = .milestone.title -}}
    {{- end -}}

    {{- $stateColor := "green" -}}
    {{- if eq .state "CLOSED" -}}
        {{- $stateColor = "red" -}}
    {{- end -}}

    {{- printf "%s  %s  %s  %s  %s  %s\n"
        (printf "%-7s" (printf "#%v" .number) | autocolor $stateColor)
        (printf "%-14s" (timeago .updatedAt) | autocolor "white+d")
        (printf "%-60s" (truncate 60 .title) | autocolor "white+h")
        (printf "%-20s" .author.login | autocolor "white+d")
        (printf "%-16s" (truncate 16 $milestoneTitle) | autocolor "white+h")
        (pluck "name" .labels | join ", " | autocolor "white+d")
    -}}
{{- end -}}
