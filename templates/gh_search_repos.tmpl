{{- $headerColor := "blue+b" -}}
{{- printf "%s  %s  %s  %s  %s\n"
    (printf "%-40s" "REPOSITORY" | autocolor $headerColor)
    (printf "%-40s" "DESCRIPTION" | autocolor $headerColor)
    (printf "%7s" "STARS" | autocolor $headerColor)
    (printf "%-12s" "LANGUAGE" | autocolor $headerColor)
    ("UPDATED" | autocolor $headerColor)
-}}

{{- range . -}}
    {{- $desc := "" -}}
    {{- if ne .description nil -}}
        {{- $desc = .description -}}
    {{- end -}}

    {{- $lang := "" -}}
    {{- if ne .language nil -}}
        {{- $lang = .language -}}
    {{- end -}}

    {{- printf "%s  %s  %s  %s  %s\n"
        (printf "%-40s" .fullName | autocolor "green")
        (printf "%-40s" (truncate 40 $desc) | autocolor "white+d")
        (printf "%7.0f" .stargazersCount | autocolor "white+h")
        (printf "%-12s" $lang | autocolor "cyan")
        ((timeago .updatedAt) | autocolor "white+d")
    -}}
{{- end -}}
