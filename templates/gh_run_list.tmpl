{{- $headerColor := "blue+b" -}}
{{- printf "%s  %s  %s  %s  %s  %s  %s\n"
    (printf "%-16s" "STATUS" | autocolor $headerColor)
    (printf "%-14s" "LAST UPDATE" | autocolor $headerColor)
    (printf "%-24s" "WORKFLOW" | autocolor $headerColor)
    (printf "%-30s" "BRANCH" | autocolor $headerColor)
    (printf "%-50s" "TITLE" | autocolor $headerColor)
    (printf "%-18s" "EVENT" | autocolor $headerColor)
    ("ID" | autocolor $headerColor)
-}}

{{- range . -}}
    {{- $statusColor := "yellow" -}}
    {{- $statusText := .status -}}
    {{- if ne (len .conclusion) 0 -}}
        {{- $statusText = .conclusion -}}
        {{- if eq .conclusion "failure" "startup_failure" -}}
            {{- $statusColor = "red" -}}
        {{- else if eq .conclusion "cancelled" "timed_out" -}}
            {{- $statusColor = "red+d" -}}
        {{- else if eq .conclusion "action_required" -}}
            {{- $statusColor = "magenta+h" -}}
        {{- else if eq .conclusion "stale" -}}
            {{- $statusColor = "yellow+d" -}}
        {{- else if eq .conclusion "success" -}}
            {{- $statusColor = "green" -}}
        {{- else if eq .conclusion "skipped" -}}
            {{- $statusColor = "white+d" -}}
        {{- end -}}
    {{- end -}}

    {{- printf "%s  %s  %s  %s  %s  %s  %s\n"
        (printf "%-16s" $statusText | autocolor $statusColor)
        (printf "%-14s" (timeago .updatedAt) | autocolor "white+d")
        (printf "%-24s" (truncate 24 .name) | autocolor "white+h")
        (printf "%-30s" (truncate 30 .headBranch) | autocolor "white+d")
        (printf "%-50s" (truncate 50 .displayTitle) | autocolor "white+h")
        (printf "%-18s" .event | autocolor "white+d")
        (.databaseId | autocolor "white+h")
    -}}
{{- end -}}
